# AITUNNEL GPT-5.6 luna line. Put the real key in .env.local or cloud/.env.
PLG_LLM_PROVIDER=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
# OPENROUTER_API_KEY=

# Titans: luna-pro architect -> luna composer -> luna QA -> deterministic builder.
PLG_LLM_PIPELINE=
PLG_TITAN_ARCHITECT_MODEL=
PLG_TITAN_COMPOSER_MODEL=
PLG_TITAN_QA_MODEL=
PLG_OPENROUTER_TIMEOUT_MS=
PLG_MAX_BEAT_COST_RUB=
PLG_TITAN_ARCHITECT_COST_RUB=
PLG_TITAN_COMPOSER_COST_RUB=
PLG_TITAN_QA_COST_RUB=
PLG_TITAN_ARCHITECT_MAX_TOKENS=
PLG_TITAN_COMPOSER_MAX_TOKENS=
# Architect resilience: short leash + fast retry.
PLG_TITAN_ARCHITECT_TIMEOUT_MS=
# PLG_TITAN_ARCHITECT_FALLBACK_MODEL=
PLG_RUB_PER_USD=

# --- Product focus ---
# MVP ships hip-hop only: trap/rage/opium/phonk/drill/boombap/lofi/pop_rap/
# jersey/rnb. Any other ask (pop, EDM, house...) lands on its nearest hip-hop
# cousin. Full 30-lane router stays in the code: PLG_LANES=all restores it.
# PLG_LANES=

# --- Fleet learning (the data moat) ---
# Every user's 👍/👎 goes to the cloud; the aggregated "what the fleet likes"
# comes back to every client: guides best-of-N selection from day one (before
# personal taste is trained) and tilts the corpus toward winning progressions.
# PLG_FLEET_REWARD=

# Mixer INSERT plugin chains (Reverb 2 / Delay 3 / Blood Overdrive) are
# quarantined until byte-verified against a live FL session — a generated
# project was seen with Delay 3 on the MASTER insert. The 808 дисторшн ships at
# the sampler level (precomputed CLIP + BOOST) which is template-proven.
# PLG_INSERT_SPACE_FX=

# --- Beat quality engine ---
# Genre brain: the LLM reads ANY free-form prompt («грустный бит для ночной
# поездки») and routes it to the right lane (BPM/progressions/drums/samples).
# Explicit genre words / artist references skip the LLM call (free, instant).
# PLG_GENRE_BRAIN=
# PLG_GENRE_BRAIN_MODEL=
# Style corpus: proven chord progressions / genre pockets / BPM ranges baked
# into every generation (prompt + deterministic 808 walk). auto = on.
# PLG_USE_STYLE_CORPUS=
# Best-of-N: expand each LLM pattern into N deterministic groove variants
# (CPU-only, no extra LLM cost), score them, keep the winner. 1 = off.
# PLG_BEST_OF_VARIANTS=
# Hook composer: weak LLM melodies are replaced by a chord-following hook
# (voice-led over the pinned progression) on non-trap lanes. auto = on.
# PLG_HOOK_COMPOSER=
# Beat switch: the song evolves — 2nd verse rides off-beat hats, the final
# chorus lifts an octave + denser hats, drums cut for 1 bar before it. auto = on.
# PLG_BEAT_SWITCH=
# MIDI corpus: your library's .mid files feed melody (transposed to the session
# key, led onto the progression, 2 seeded mutations — never a 1:1 copy), real
# 808 lines and hat grooves from deconstruction kits. auto = on.
# PLG_MIDI_CORPUS=

# Legacy providers are intentionally not the default path.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- AI Director (optional) ---
# DeepSeek reads web intel and writes a tight production brief.
# PLG_USE_DIRECTOR=
# DEEPSEEK_API_KEY=
# PLG_DIRECTOR_MODEL=
# PLG_DIRECTOR_TIMEOUT_S=

# --- Real-time reference boost (optional) ---
# For detailed prompts, PLG searches the web for current production guides and
# folds BPM/key/drum/FX hints into generation. Honest UI status ("Analyzing
# references"). Short prompt / offline / any error -> silently skipped.
# Keep off for the pure DeepSeek/Qwen path. Enable only if you explicitly want
# external reference search.
# PLG_REFERENCE_SEARCH=
# PLG_SEARCH_PROVIDER=
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# PLG_SEARCH_MIN_WORDS=
# PLG_SEARCH_TIMEOUT_S=
# PLG_SEARCH_MAX_RESULTS=

# Your library — a kit pack / Splice / kits (see organize_kit.py)
PLG_SAMPLES_DIR=

# Open FL Studio automatically after CREATE BEAT (true / false)
PLG_AUTO_OPEN_FL=

# Optional: force a specific FL install (otherwise auto-detect newest FL 20–2025+)
# PLG_FL_EXE=

# --- Cloud mode (Phase 1 — subscription, server-side AI) ---
# PLG_CLOUD_MODE=
# PLG_CLOUD_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# PLG_ENV=

# Crash reporting (optional)
# PLG_SENTRY_DSN=

# Beat quota (30 beats / 30-day subscription period) — local fallback when PLG_CLOUD_MODE=false
# PLG_BEAT_LIMIT=
# PLG_BEAT_PERIOD_DAYS=
# PLG_SUBSCRIPTION_START=
# PLG_SKIP_BEAT_LIMIT=

# Optional: FL Studio profile for manual_steps (copy user_profile.example.json -> user_profile.json)
