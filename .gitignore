# Secrets
.env
.env.local
cloud/.env
cloud/.env.staging
cloud/.env.umami

# Local-only / large (sample packs, agent tooling, scratch renders)
.claude/
PLG_Sounds/
PLG_Sounds_FL/
PLG_MIDI/
PLG_Archive/
preview.wav

# Personal MIDI/audio and archived run results are local working material.
assets/starter/**/*.wav
assets/starter/**/*.mp3
assets/starter/**/*.flac
assets/starter/**/*.aif
assets/starter/**/*.aiff
archive/generated-artifacts-*/
archive/debug-artifacts-*/

# Verification/control generation runs (FLP + pattern.json dumps produced
# while working on a change) — outputs, never source. Same category as the
# archive/*-artifacts-*/ dirs above.
CONTROL_*/
# The FLP/pattern.json dumps are output; the batch harness that produced them
# is source, so .py inside these folders stays tracked.
PLG_Beats_*/*
!PLG_Beats_*/*.py

# Same category, ad hoc naming: one-off verify/smoke/compare runs dumped at
# the repo root while working on the engine (e.g. PLG_RC_Smoke/,
# PLG_SeedV2_Compare/, PLG_OptionC_Verify/), plus loose generated sessions
# next to the already-ignored PLG_Session.flp.
/PLG_*_Verify/
/PLG_*_Smoke/
/PLG_*_Compare/
/PLG_*.flp

# pytest scratch trees that used to accumulate in the source root
.pytest_tmp_*/

