YOOKASSA_SECRET_KEY=



# International — behind the intl_billing feature flag (off by default).
# Prodamus is the intl provider (foreign-card acquiring ЮKassa can't do) for
# the eu/other/by price-book tiers only; ru (RUB) stays on ЮKassa. Provider
# code is in cloud/app/providers/prodamus_provider.py. See
# docs/PRODAMUS_INTL_BILLING_PLAN.md. Leave unset until Prodamus confirms the
# international method for the account (plan §6.0) — either PRODAMUS_* var
# unset keeps pick_checkout_provider() raising 503 for eu/other/by.

# PRODAMUS_FORM_URL=

# PRODAMUS_SECRET_KEY=

# STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET=

# STRIPE_PRICE_ID_INTL=

# PADDLE_API_KEY=

# PADDLE_WEBHOOK_SECRET=



# Client version gate

PLG_APP_VERSION=

PLG_MIN_CLIENT_VERSION=



# Kill switch

PLG_EST_COST_BASE_USD=

PLG_EST_COST_PREMIUM_USD=



# Local dev without Supabase auth (NEVER in production)

# PLG_CLOUD_DEV_BYPASS=

# Phase 3 — Security
PLG_GEN_COOLDOWN_SEC=
PLG_GEN_HOURLY_LIMIT=
PLG_IP_HOURLY_LIMIT=
# Password-login brute-force lockout: N failed attempts for one account (or
# from one IP) within the window lock further attempts for the rest of it.
PLG_LOGIN_MAX_FAILURES=
PLG_LOGIN_LOCKOUT_SEC=
PLG_IP_DAILY_GEN_ALERT=
PLG_LLM_QUEUE_SLOTS=
PLG_REQUIRE_DEVICE_BINDING=
# Comma-separated device IDs that may claim the one-per-device free beat
# repeatedly. Dev/QA machines only — leave empty in production.
# PLG_TRIAL_FARM_EXEMPT_DEVICE_IDS=
# The one-free-beat-per-device claim ages out after this many days so a genuine
# reinstall / hand-me-down PC self-heals with no support step. 0 = permanent.
PLG_TRIAL_CLAIM_TTL_DAYS=
PLG_CAPTCHA_PROVIDER=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Yandex SmartCaptcha (RU-hosted, 152-FZ friendly) — set PLG_CAPTCHA_PROVIDER=yandex to use it
# YANDEX_CAPTCHA_SITE_KEY=
# YANDEX_CAPTCHA_SECRET_KEY=
# PLG_ADMIN_SECRET=

# Real client IP source. Prod terminates TLS on our own Caddy (Timeweb VDS),
# which sets X-Forwarded-For — no Cloudflare in the path.
PLG_TRUSTED_PROXY=
# Offline IP -> country DB for price/currency routing (DB-IP Lite .mmdb, EU
# publisher, CC-BY-4.0). Resolved entirely on this server; the IP never leaves
# the box. Default path is cloud/app/data/dbip-country-lite.mmdb — see
# cloud/app/data/README.md. Absent -> everyone gets the domestic (RUB) price.
# PLG_GEOIP_DB=

# Phase 4 — Infra
PLG_ENV=
# REDIS_URL=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
# PLG_WAITLIST_MODE=
# PLG_INVITE_ONLY=

# Phase 5 — Legal
PLG_LEGAL_TERMS_VERSION=
PLG_LEGAL_PRIVACY_VERSION=
PLG_LEGAL_MIN_AGE=
PLG_PROMPT_LOG_RETENTION_DAYS=
PLG_PAYMENT_LOG_RETENTION_DAYS=
PLG_DATA_REGION=
PLG_SUPPORT_EMAIL=

# Phase 6 — Ops
# No Telegram channel or status page exist yet — leave blank until they do.
PLG_SUPPORT_TELEGRAM=
PLG_SUPPORT_UPDATES_URL=
PLG_SUPPORT_SLA_HOURS=
PLG_STATUS_PAGE_URL=
# Set these only in the Timeweb server environment. Never add the API key to
# the landing files, Git, or the desktop client.
UNISENDER_API_KEY=
PLG_EMAIL_FROM=
UNISENDER_VERIFICATION_TEMPLATE_ID=
UNISENDER_PASSWORD_RESET_TEMPLATE_ID=
# Optional dedicated HMAC secret for one-time email codes. If left blank, the
# server-only Supabase service key is used as the fallback.
PLG_EMAIL_VERIFICATION_SECRET=
PLG_EMAIL_VERIFICATION_TTL_MINUTES=
PLG_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=
PLG_EMAIL_VERIFICATION_MAX_ATTEMPTS=
POSTHOG_API_KEY=
PLG_RELEASE_DOWNLOAD_URL=
PLG_RELEASE_NOTES=
