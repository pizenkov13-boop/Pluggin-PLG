# PLG cloud — SELF-HOSTED Supabase in Russia (152-ФЗ data localization).
#
# Copy to cloud/.env on the RU server and fill the real values. This template
# points the API at a self-hosted Supabase stack (Postgres + GoTrue + Kong)
# running on a VDS inside the Russian Federation, so RF citizens' personal data
# (email in auth.users) is collected on RF soil first. See
# cloud/infra/ru-hosting-runbook.md for the full stand-up procedure.
#
# The API code needs NO changes for self-host: it talks to Supabase over the
# same REST API and verifies HS256 JWTs via SUPABASE_JWT_SECRET (auth.py).

# --- Supabase (self-hosted on the RU VDS) ---
# The Kong gateway URL of your self-hosted Supabase (http on localhost behind
# your reverse proxy, or https via your domain). NOT *.supabase.co.
SUPABASE_URL=
# service_role key from the self-hosted stack's .env (SERVICE_ROLE_KEY).
SUPABASE_SERVICE_KEY=
# GoTrue signs user JWTs with HS256 using this secret (the stack's JWT_SECRET).
# Setting it makes auth.py use the HS256 shared-secret path (correct + safe for
# self-host). Do NOT also set SUPABASE_JWKS_URL — the secret path takes priority.
SUPABASE_JWT_SECRET=

# --- Data region label (drives legal disclosures) ---
PLG_DATA_REGION=
PLG_LEGAL_TERMS_VERSION=
PLG_LEGAL_PRIVACY_VERSION=
PLG_SUPPORT_EMAIL=
UNISENDER_API_KEY=
PLG_EMAIL_FROM=
UNISENDER_VERIFICATION_TEMPLATE_ID=
UNISENDER_PASSWORD_RESET_TEMPLATE_ID=
PLG_EMAIL_VERIFICATION_SECRET=
PLG_EMAIL_VERIFICATION_TTL_MINUTES=
PLG_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=
PLG_EMAIL_VERIFICATION_MAX_ATTEMPTS=

# --- AITUNNEL GPT-5.6 luna (server-side key — never ships to clients) ---
PLG_LLM_PROVIDER=
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
PLG_LLM_PIPELINE=
PLG_TITAN_ARCHITECT_MODEL=
PLG_TITAN_COMPOSER_MODEL=
PLG_TITAN_QA_MODEL=
PLG_MAX_BEAT_COST_RUB=
PLG_TITAN_ARCHITECT_COST_RUB=
PLG_TITAN_COMPOSER_COST_RUB=
PLG_TITAN_QA_COST_RUB=

# --- Payments (ЮKassa — RF) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PLG_PRICE_CIS_RUB=

# --- Payments (Prodamus — international eu/other tiers only, behind the
# intl_billing feature flag; ru stays on YooKassa) ---
# PRODAMUS_FORM_URL=
# PRODAMUS_SECRET_KEY=

# --- Subscription shape ---
PLG_BEAT_LIMIT=
PLG_BEAT_PERIOD_DAYS=
PLG_TRIAL_BEATS=
# One free beat per device; the claim ages out after this many days so a real
# reinstall self-heals. 0 = permanent claim.
PLG_TRIAL_CLAIM_TTL_DAYS=

# --- Production hardening ---
PLG_ENV=
# Redis for rate limits (self-host redis on the same VDS is fine).
REDIS_URL=
# Lock CORS to your site; the desktop app uses Bearer tokens, not cookies.
PLG_ALLOWED_ORIGINS=
# If behind Nginx/Caddy on the same box, trust its forwarded IP. Make sure the
# proxy *replaces* X-Forwarded-For (Nginx: `proxy_set_header X-Forwarded-For
# $remote_addr`; Caddy: `header_up X-Forwarded-For {remote_host}`) — the default
# Caddy behaviour APPENDS, which lets a client spoof the first hop and dodge
# every IP limit/ban.
PLG_TRUSTED_PROXY=
PLG_ADMIN_SECRET=
# Password-login brute-force lockout (per account + per IP).
PLG_LOGIN_MAX_FAILURES=
PLG_LOGIN_LOCKOUT_SEC=

# --- Anti-abuse ---
# CAPTCHA is off by default (the project issue log (not included) §0aj): Cloudflare Turnstile sends
# data outside RF (excluded for 152-FZ), and Yandex SmartCaptcha is unreachable
# from networks that can't reach Yandex Cloud, which silently blocks signup
# with no error shown. Rate-limits + brute-force lockout below are relied on
# instead. Re-enable only after a provider is confirmed reachable for your
# actual user base:
PLG_CAPTCHA_PROVIDER=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# YANDEX_CAPTCHA_SITE_KEY=
# YANDEX_CAPTCHA_SECRET_KEY=
