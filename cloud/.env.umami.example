# Self-hosted Umami (landing analytics) — RU hosting runbook Шаг 5b.
# Copy to cloud/.env.umami on the VDS (never commit the filled-in copy —
# it's already covered by .gitignore) and fill in real values.

# Points at the SAME Postgres instance the Supabase stack already runs
# (supabase-db, reachable on the supabase_default docker network — the same
# trick plg-api-run.sh uses), in a dedicated `umami` database/role created in
# Шаг 5b. Not a second Postgres container.
DATABASE_URL=
DATABASE_TYPE=

# 32+ random chars — signs Umami's own session cookies. Generate with:
#   openssl rand -hex 32
APP_SECRET=

# Kill every outbound call Umami can make on its own: anonymous usage
# telemetry to Umami's own servers, the update-check ping, and the
# duckduckgo.com favicon lookup used in the dashboard UI.
DISABLE_TELEMETRY=
DISABLE_UPDATES=
PRIVATE_MODE=
